{
  "manifest_version": 3,
  "name": "BOLD700 UX Review — pins",
  "version": "1.1.0",
  "description": "Klik met de rechtermuisknop op elke website en laat feedback-pins achter bij een UX-review.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://securetoken.googleapis.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://uxreviews.bold700.com/*",
      "http://localhost/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Feedback-pins aanzetten"
  }
}
